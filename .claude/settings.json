{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git fetch*)",
      "Bash(git branch --show-current)", "Bash(git branch --list*)",
      "Bash(git check-ignore*)", "Bash(git remote get-url*)", "Bash(git ls-remote*)",
      "Bash(git lfs version)", "Bash(git lfs env)", "Bash(git --version)"
    ]
  }
}
